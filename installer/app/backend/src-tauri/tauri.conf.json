{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": []
  },
  "build": {
    "beforeBuildCommand": {
      "cwd": "../../frontend",
      "script": "pnpm build"
    },
    "beforeDevCommand": {
      "cwd": "../../frontend",
      "script": "pnpm dev"
    },
    "devUrl": "http://localhost:1430",
    "frontendDist": "../../frontend/dist"
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "identifier": "com.clippity.installer",
  "productName": "Clippity Setup",
  "version": "1.5.0"
}
