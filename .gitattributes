# Normalize line endings: LF in the repository, native in the working copy.
* text=auto

# Lockfiles and generated assets: keep diffs out of review, collapse in stats.
pnpm-lock.yaml linguist-generated=true -diff
Cargo.lock     linguist-generated=true -diff

# Docs screenshots are binary; don't let a text filter near them.
*.png binary
*.ico binary
