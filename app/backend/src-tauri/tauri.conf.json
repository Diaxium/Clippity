{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": []
  },
  "build": {
    "beforeBuildCommand": {
      "cwd": "../../frontend",
      "script": "pnpm build"
    },
    "beforeDevCommand": {
      "cwd": "../../frontend",
      "script": "pnpm dev"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../frontend/dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "identifier": "com.clippity.app",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFOUREQTcyREIzOUI1MTQKUldRVXRUbmJjdHFkcmxrYUQ2V3FFck1ycWsrMDVoRTNDU054SHZ6eXRWdnJFdzBkb0hYb2tSaFMK"
    }
  },
  "productName": "Clippity",
  "version": "0.1.0"
}
