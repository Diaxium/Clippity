{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "ES2024.Promise", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@app/*": ["src/app/*"],
      "@features/*": ["src/features/*"],
      "@windows/*": ["src/windows/*"],
      "@shared/*": ["src/shared/*"],
      "@services/*": ["src/services/*"],
      "@state/*": ["src/state/*"],
      "@styles/*": ["src/styles/*"],
      "@config/*": ["src/config/*"],
      "@assets/*": ["src/assets/*"]
    },

    // `node` is here for the tests, not the app. `redact.test.ts` reads a
    // fixture off disk, and a handful of specs read `process.env`. Vitest 3
    // pulled the Node types in transitively; Vitest 4 does not, so they have
    // to be named. Nothing under `src` that ships imports a Node builtin —
    // the bundle would fail to build if it did.
    "types": ["node", "vite/client", "@testing-library/jest-dom"]
  },
  "include": ["src"]
}
